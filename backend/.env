# AI Manus Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Configuration (Required)
# ===========================================
# Your LLM API key (OpenAI, DeepSeek, or compatible)
API_KEY=${GROQ_API_KEY}

# LLM API base URL
API_BASE=https://api.groq.com/openai/v1

# Model name
MODEL_NAME=moonshotai/kimi-k2-instruct-0905

# Temperature (0-1)
TEMPERATURE=0.7

# Max tokens per response
MAX_TOKENS=2000

# ===========================================
# E2B Sandbox Configuration (Required)
# ===========================================
# Get your API key from https://e2b.dev/dashboard
E2B_API_KEY=${E2B_API_KEY}

# E2B sandbox template (base, python, nodejs, rust, etc.)
E2B_TEMPLATE=base

# Execution timeout in seconds
E2B_TIMEOUT=300

# ===========================================
# MongoDB Configuration
# ===========================================
# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name
MONGODB_DATABASE=manus

# MongoDB credentials (optional)
#MONGODB_USERNAME=
#MONGODB_PASSWORD=

# ===========================================
# Redis Configuration
# ===========================================
# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis database number
REDIS_DB=0

# Redis password (optional)
#REDIS_PASSWORD=

# ===========================================
# Search Engine Configuration
# ===========================================
# Search provider: baidu, google, bing
SEARCH_PROVIDER=bing

# Google Search API (only if SEARCH_PROVIDER=google)
#GOOGLE_SEARCH_API_KEY=
#GOOGLE_SEARCH_ENGINE_ID=

# ===========================================
# Authentication Configuration
# ===========================================
# Auth provider: password, none, local
AUTH_PROVIDER=none

# Password auth settings (only if AUTH_PROVIDER=password)
#PASSWORD_SALT=
#PASSWORD_HASH_ROUNDS=10

# Local auth settings (only if AUTH_PROVIDER=local)
#LOCAL_AUTH_EMAIL=admin@example.com
#LOCAL_AUTH_PASSWORD=admin

# ===========================================
# JWT Configuration
# ===========================================
# JWT secret key (change in production!)
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration (days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Email Configuration
# ===========================================
# Only required if AUTH_PROVIDER=password
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USERNAME=your-email@gmail.com
#EMAIL_PASSWORD=your-password
#EMAIL_FROM=your-email@gmail.com

# ===========================================
# MCP Configuration
# ===========================================
# MCP config file path (optional)
#MCP_CONFIG_PATH=/etc/mcp.json

# ===========================================
# Logging Configuration
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
